# Copy this file to .env before running Docker Compose. The real .env file is
# ignored by Git.
RISU_RUNTIME_USER=risu
RISU_RUNTIME_PASSWORD=replace-with-a-long-random-password
# The Compose file also uses this value to initialize the RisuAI Node password
# on a fresh volume. Existing save/__password values are never overwritten.
# Use the server's LAN/VPN address for remote access. The loopback default is
# deliberately non-public.
RISU_RUNTIME_BIND=127.0.0.1
RISU_RUNTIME_PORT=6002
# Change these together only if the private subnet overlaps an existing Docker,
# LAN, or VPN route.
RISU_RUNTIME_SUBNET=172.30.107.0/24
RISU_APP_IPV4=172.30.107.10
RISU_BROWSER_IPV4=172.30.107.20
RISU_RUNTIME_PUID=1000
RISU_RUNTIME_PGID=1000
TZ=Asia/Seoul

# Durable job retention. Time values are positive integer milliseconds; count
# limits apply to terminal records after the age policy and may prune older
# terminal records sooner. Queued/running records are not age-pruned.
# Proxy jobs acknowledged after terminal transport consumption: 7 days.
RISU_PROXY_STREAM_ACKNOWLEDGED_RETENTION_MS=604800000
# Terminal proxy jobs not acknowledged by a client: 14 days.
RISU_PROXY_STREAM_UNACKNOWLEDGED_RETENTION_MS=1209600000
RISU_PROXY_STREAM_MAX_TERMINAL_JOBS=2000
# Terminal generation commands: 30 days.
RISU_RUNTIME_GENERATION_RETENTION_MS=2592000000
RISU_RUNTIME_GENERATION_MAX_TERMINAL_COMMANDS=2000
# Maximum decoded provider response retained by one proxy job: 256 MiB.
RISU_PROXY_STREAM_MAX_RESPONSE_BYTES=268435456
# Maximum event-spool bytes across all proxy jobs: 2 GiB. Active jobs reserve
# enough space to persist a terminal error even when the shared quota fills.
RISU_PROXY_STREAM_MAX_SPOOL_BYTES=2147483648
# Maximum bytes accounted by regular save-root files (database/auth, flat
# assets, inlays, MCP payloads, V3 permissions, and backups) and the minimum
# filesystem free-space reserve. Generation/proxy subdirectories use their own
# limits above.
RISU_SAVE_MAX_BYTES=8589934592
RISU_SAVE_MIN_FREE_BYTES=1073741824

# This tag is deliberately pinned. Review and update it explicitly instead of
# allowing an unattended browser image update.
RISU_CHROMIUM_IMAGE=ghcr.io/linuxserver/chromium:version-3d7cd855@sha256:6ad21b594a3ad1c9cf77eeac9c713e7d840927a842f706e39de8f6b64c5de6e6
