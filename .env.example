# Copy this file to .env before running Docker Compose. The real .env file is
# ignored by Git.
RISU_RUNTIME_USER=risu
RISU_RUNTIME_PASSWORD=replace-with-a-long-random-password
RISU_RUNTIME_PORT=6002
RISU_RUNTIME_PUID=1000
RISU_RUNTIME_PGID=1000
TZ=Asia/Seoul

# This tag is deliberately pinned. Review and update it explicitly instead of
# allowing an unattended browser image update.
RISU_CHROMIUM_IMAGE=ghcr.io/linuxserver/chromium:version-b0ddd401@sha256:47fc8bb18cdb0844199a16e1e14b3b38ba97f6ad1659895c243ba5f2384aad1e
